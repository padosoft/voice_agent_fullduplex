{
    "name": "agents-full-duplex/laravel-realtime-agent",
    "description": "Provider-neutral Laravel core and browser bridge for full-duplex realtime agents.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "realtime",
        "agents",
        "voice",
        "full-duplex"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "AgentsFullDuplex\\RealtimeAgent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AgentsFullDuplex\\RealtimeAgent\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "format:test": "pint --test",
        "test": "phpunit",
        "check": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "demo": "php examples/lesson.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AgentsFullDuplex\\RealtimeAgent\\RealtimeAgentServiceProvider"
            ],
            "aliases": {
                "RealtimeAgent": "AgentsFullDuplex\\RealtimeAgent\\Facades\\RealtimeAgent"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
