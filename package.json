{
  "name": "@agents-full-duplex/realtime-agent-client",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "resources/schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run resources/js",
    "test:e2e": "playwright test",
    "demo": "tsx examples/browser-demo.ts",
    "schema:check": "node scripts/check-schema-sync.mjs",
    "readme:check": "node scripts/validate-readme.mjs",
    "check": "npm run build && npm run schema:check && npm run readme:check && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  }
}
