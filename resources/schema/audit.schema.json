{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-full-duplex.dev/schemas/realtime-agent-audit@1",
  "title": "Realtime Agent Session Audit v1",
  "type": "object",
  "required": ["schema", "session_id", "provider", "provider_session_id", "messages", "usage", "tool_calls", "totals"],
  "properties": {
    "schema": { "const": "realtime-agent-audit@1" },
    "session_id": { "type": "string" },
    "provider": { "type": "string" },
    "provider_session_id": { "type": ["string", "null"] },
    "messages": { "type": "array", "items": { "$ref": "message.schema.json" } },
    "usage": { "type": "array", "items": { "$ref": "usage.schema.json" } },
    "tool_calls": { "type": "array", "items": { "type": "object" } },
    "totals": {
      "type": "object",
      "required": ["estimated", "final", "effective", "unpriced_records"],
      "properties": {
        "estimated": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{8}$" } },
        "final": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{8}$" } },
        "effective": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{8}$" } },
        "unpriced_records": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
